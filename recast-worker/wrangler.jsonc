{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recast",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "ENTITLEMENTS",
      "id": "e4c46dd48933470982a82158aedab4ad"
    }
  ],

  "vars": {
    "SITE_URL": "https://tryrecast.app/",
    "PRICE_MAP": "{\"price_price_1U41Bw07vRRG7JsXH0iAKy7g\":\"pro_monthly\",\"price_price_1U41Bx07vRRG7JsXlwnms0uo\":\"pro_yearly\",\"price_1U41Bs07vRRG7JsXnYpcoHh1\":\"api_monthly\",\"price_1U41Br07vRRG7JsXV1vskFmE\":\"api_yearly\",\"price_1U4Kub07vRRG7JsXtMatleol\":\"day_pass\"}"
  }

  // STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are NOT set here — secrets
  // never belong in a config file that might get committed to git. Set them
  // with `wrangler secret put` instead (see README.md).
}
