{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recast",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "ENTITLEMENTS",
      "id": "e4c46dd48933470982a82158aedab4ad"
    }
  ],

  "vars": {
    "SITE_URL": "https://tryrecast.app/",
    "PRICE_MAP": "{\"price_REPLACE_PRO_MONTHLY\":\"pro_monthly\",\"price_REPLACE_PRO_YEARLY\":\"pro_yearly\",\"price_REPLACE_API_MONTHLY\":\"api_monthly\",\"price_REPLACE_API_YEARLY\":\"api_yearly\"}"
  }

  // STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are NOT set here — secrets
  // never belong in a config file that might get committed to git. Set them
  // with `wrangler secret put` instead (see README.md).
}
